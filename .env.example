# Copiá este archivo como `.env` y completá valores (nunca subas `.env` a Git).

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Alias opcional (telegram_utils.py también lo lee):
# TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# IA_AUTO_TELEGRAM_TRADES=1   aviso tras cada orden OK en ia_auto_trade_loop
# IA_AUTO_TELEGRAM_RICH=1     mensaje detallado HTML (score, DXY, sesión); 0 = texto corto
# Con IA_TELEGRAM_PANIC_ENABLE=1: /STATUS estado, /BITACORA adjunta CSV de bitácora (IA_JOURNAL_CSV)
# TELEGRAM_PARSE_MODE=HTML    default en telegram_utils; Markdown si preferís *negrita*

# --- MetaTrader 5 ---
# MT5_PATH=C:\\Program Files\\MetaTrader 5\\terminal64.exe
TRADE_SYMBOL=XAUUSD
BOT_MAGIC=260505

# Solo oro (misma vista que en MT5); para más símbolos: IA_SCAN_SYMBOLS=XAUUSD,EURUSD
# IA_SCAN_SYMBOLS=XAUUSD

# --- Bot / loops (activar solo lo que uses) ---
# IA_AUTO_ENABLE=1
# IA_SENTIMENT_M15_ENABLE=1
# DAILY_REPORT_ENABLE=1
# IA_NEWS_ALERT_ENABLE=1
# NEWS_API_KEY=

# --- Optuna / params_optimized.json (sobrescritura de parámetros) ---
# IA_OPTUNA_APPLY=1            # 0 para ignorar params_optimized.json
# IA_OPTUNA_PARAMS_PATH=       # ruta explícita a .json/.env (si no, usa params_optimized.json)
# IA_OPTUNA_EXCLUDE_KEYS=      # lista CSV de claves a NO sobrescribir (p.ej. IA_MIN_CONFIDENCE,RSI_FILTER)
# IA_OPTUNA_REPORT_OVERRIDES=1 # imprime una vez qué claves fueron sobrescritas al iniciar
# local_env.merge_optuna_into_config({}) — fusiona JSON Optuna en dict y os.environ tras load_env_file

# --- Sin órdenes tras abrir mercado (NY): relajar filtros (ia_auto_trade_loop) ---
# IA_AUTO_RELAX_ENABLE=1
# IA_AUTO_RELAX_AFTER_HOURS=2
# IA_AUTO_RELAX_STEP_HOURS=1.5
# IA_AUTO_RELAX_MAX_LEVEL=3
# IA_AUTO_RELAX_TZ=America/New_York
# IA_AUTO_RELAX_OPEN_HOUR=8
# IA_AUTO_RELAX_OPEN_MINUTE=0
# IA_AUTO_RELAX_MOMENTUM_BODY=0.35
# IA_BOT_RELAX_SIGNALS=1  — más entradas en demo (gatillo M15 sin volumen estricto; apaga EMA H4 align y momentum)

# --- Sin órdenes tras abrir mercado (NY): relajar filtros automáticamente (ia_auto_trade_loop) ---
# IA_AUTO_RELAX_ENABLE=1
# IA_AUTO_RELAX_AFTER_HOURS=2
# IA_AUTO_RELAX_STEP_HOURS=1.5
# IA_AUTO_RELAX_MAX_LEVEL=3
# IA_AUTO_RELAX_TZ=America/New_York
# IA_AUTO_RELAX_OPEN_HOUR=8
# IA_AUTO_RELAX_OPEN_MINUTE=0
# IA_AUTO_RELAX_MOMENTUM_BODY=0.35

# PROFIT_MAX=1
# WINRATE_TARGET=0.85
# SENTIMENT_FILTER=1

# --- Detección de régimen (market_regime.py) meta-capa antes de la señal tendencial ---
# IA_REGIME_ENABLE=0
# IA_REGIME_MODE=rules
# IA_REGIME_TIMEFRAME=H1
# IA_REGIME_BLOCK_HIGH_VOL=1
# IA_REGIME_BLOCK_TREND_IN_RANGE=1
# IA_REGIME_ML_MODEL_PATH=

# --- Calidad de ejecución / slippage (trade_audit.py, usado por ia_auto_trade_loop) ---
# IA_EXEC_QUALITY_ENABLE=1
# IA_EXEC_QUALITY_CSV=execution_quality.csv
# IA_LOG_MAX_MB=5
# IA_EXEC_LOG_MAX_MB=5
# IA_EXEC_SLIP_GUARD_ENABLE=1
# IA_EXEC_SLIP_GUARD_WINDOW=3
# IA_SLIPPAGE_WINDOW=3
# IA_EXEC_SLIP_GUARD_MAX_AVG_PTS=8
# IA_MAX_SLIPPAGE_AVG=50
# IA_EXEC_SLIP_GUARD_MIN_SAMPLES=3

# --- Auto-trading safety ---
# IA_AUTO_MAX_TOTAL_RISK_PERCENT=0
#   Si >0, el bot calcula el riesgo estimado al SL de TODAS las posiciones abiertas con BOT_MAGIC
#   y no abre una nueva orden si el total superaría este % de equity (fail-open si no se puede estimar).
#
# Sizing por riesgo (lote dinámico, recomendado):
# IA_AUTO_RISK_BUNDLE_PERCENT=1   # % equity total a repartir
# IA_AUTO_RISK_BUNDLE_TRADES=1    # operaciones en el bundle → riesgo por trade = bundle/trades
# IA_AUTO_RISK_PER_TRADE_PERCENT= # alternativa simple si no usás bundle
# IA_RISK_PERCENT=1.0             # alias fallback (si no definís los anteriores)
# IA_ATR_SL_MULT=2.0              # alias de IA_AUTO_SL_ATR_MULT (distancia SL = ATR×mult cuando IA_AUTO_SL_MODE=atr)

# --- Fase 1 / límites diarios (PnL cerrado BOT_MAGIC, moneda de cuenta; ia_auto_trade_loop) ---
# IA_AUTO_DAILY_PROFIT_TARGET_USD=45
# IA_AUTO_DAILY_MAX_LOSS_USD=60
# IA_AUTO_DAILY_PNL_TZ=America/Argentina/Buenos_Aires
# IA_AUTO_STOP_LOOP_ON_DAILY_PROFIT=1   # "uno y fuera": al cumplir meta, sale del bucle (default 0 = solo pausa nuevas entradas)
# IA_AUTO_STOP_LOOP_ON_DAILY_MAX_LOSS=1  # si vacío y definís MAX_LOSS, default = salir del bucle; poné 0 para solo pausar entradas
# Lotaje fijo: vaciá IA_AUTO_RISK_* y usá p.ej. IA_AUTO_LOTS=0.04

# --- Bitácora Fase 1 (CSV + alertas meta/piso; ia_trading_journal.py) ---
# IA_JOURNAL_ENABLE=1
# IA_JOURNAL_CSV=ia_phase1_journal.csv
# IA_JOURNAL_STATE=ia_trading_journal_state.json
# IA_JOURNAL_TZ=
# IA_JOURNAL_USE_EQUITY=0
# IA_JOURNAL_GRAD_USD=1250
# IA_JOURNAL_FLOOR_USD=900
# IA_JOURNAL_ALERTS=1
# IA_JOURNAL_RESET_ON_START=1   # una vez: archiva CSV + borra estado; luego quitar del .env
# Cuenta real (bitácora aparte): IA_JOURNAL_CSV=ia_phase1_journal_real.csv
#   IA_JOURNAL_STATE=ia_trading_journal_state_real.json

# =============================================================================
# PLANTILLA — CUENTA REAL Fase 1 (~$1.000 → meta $1.250)  [dejar TODO comentado en demo]
# Copiá este bloque al .env el día que operes en REAL (MT5 logueado en cuenta real).
# No uses los mismos CSV/STATE que la demo. Revisá lote y horario antes de IA_AUTO_ENABLE=1.
# =============================================================================
# IA_AUTO_ENABLE=1
# IA_AUTO_DEMO_ONLY=0
#   — 0 / sin definir = no bloquea por server DEMO (necesario en real). 1 = solo demo (default seguro).
# IA_BOT_RELAX_SIGNALS=0
#   — en real conviene 0 (sin atajos de señal de demo).
# IA_SCAN_SYMBOLS=XAUUSD
# IA_AUTO_DAILY_PNL_TZ=America/Argentina/Buenos_Aires
# IA_AUTO_DAILY_PROFIT_TARGET_USD=45
# IA_AUTO_DAILY_MAX_LOSS_USD=60
# IA_AUTO_STOP_LOOP_ON_DAILY_PROFIT=1
# IA_AUTO_STOP_LOOP_ON_DAILY_MAX_LOSS=1
# IA_AUTO_LOTS=0.04
#   — Fase 1 lote fijo: sin IA_AUTO_RISK_BUNDLE_* ni IA_AUTO_RISK_PER_TRADE_* (dejalos sin definir o comentados).
# IA_JOURNAL_ENABLE=1
# IA_JOURNAL_CSV=ia_phase1_journal_real.csv
# IA_JOURNAL_STATE=ia_trading_journal_state_real.json
# IA_JOURNAL_TZ=
# IA_JOURNAL_GRAD_USD=1250
# IA_JOURNAL_FLOOR_USD=900
# IA_JOURNAL_ALERTS=1
#   — IA_JOURNAL_RESET_ON_START=1 solo si querés corte limpio el primer día real; luego quitá.
# IA_EXEC_QUALITY_CSV=execution_quality_real.csv
#   — opcional: CSV de ejecución separado del demo.
# BOT_MAGIC=260505
#   — opcional: otro magic en real para no mezclar historial MT5 con la demo (cambiá en ambos .env y en el EA si aplica).

