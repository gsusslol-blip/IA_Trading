# Copiá este archivo como `.env` y completá valores (nunca subas `.env` a Git).

# ==== CONFIGURACIÓN BÁSICA DEL BOT ====
BOT_MAGIC=260505
IA_BOT_RELAX_SIGNALS=1
# IA_AUTO_ENABLE=1
# IA_SCAN_SYMBOLS=XAUUSD

# ==== CREDENCIALES DE TELEGRAM ====
# Token: @BotFather | Chat ID: @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_TOKEN=

# ==== PARÁMETROS DE FILTROS (scanner / riesgo) ====
IA_SCAN_SOFT_TRIGGER=0
IA_SCAN_VOLUME_RELAX=1
IA_SCAN_SKIP_BREAKOUT=0
IA_AUTO_MAX_TOTAL_RISK_PERCENT=5.0

# ==== CONTROL REMOTO Y AUTONOMÍA ====
# IA_TELEGRAM_PANIC_ENABLE=1
# IA_NEWS_FILTER_ENABLE=1
# IA_REGIME_AUTO_ENABLE=1
# IA_STREAK_ENABLE=1
# IA_MT5_RECONNECT_ENABLE=1
# IA_MARGIN_CHECK_ENABLE=1
# IA_AUTONOMY_TG_ENABLE=1

# --- Telegram (opciones extra) ---
# IA_AUTO_TELEGRAM_TRADES=1   aviso tras cada orden OK en ia_auto_trade_loop
# IA_AUTO_TELEGRAM_RICH=1     mensaje detallado HTML (score, DXY, sesión); 0 = texto corto
# Con IA_TELEGRAM_PANIC_ENABLE=1: /STATUS estado, /BITACORA adjunta CSV de bitácora (IA_JOURNAL_CSV)
# TELEGRAM_PARSE_MODE=HTML    default en telegram_utils; Markdown si preferís *negrita*

# --- MetaTrader 5 ---
# MT5_PATH=C:\\Program Files\\MetaTrader 5\\terminal64.exe
TRADE_SYMBOL=XAUUSD

# Multi-activo (misma lógica M15; DXY y ATR por clase de activo — ver ia_asset_profile.py)
# IA_SCAN_SYMBOLS=XAUUSD,EURUSD,US30
# IA_AUTO_MAX_TOTAL_RISK_PERCENT=5
# IA_AUTO_MAX_TOTAL_RISK_STRICT=1
# IA_AUTO_SL_ATR_MULT_EURUSD=1.6
# IA_AUTO_SL_ATR_MULT_US30=2.2
# IA_AUTO_SL_ATR_MULT_USDJPY=1.6
# IA_DXY_INDEX_FILTER=0

# --- Bot / loops (activar solo lo que uses) ---
# IA_AUTO_ENABLE=1
# IA_SENTIMENT_M15_ENABLE=1
# DAILY_REPORT_ENABLE=1
# IA_NEWS_ALERT_ENABLE=1
# NEWS_API_KEY=

# --- Optuna / params_optimized.json (sobrescritura de parámetros) ---
# IA_OPTUNA_APPLY=1            # 0 para ignorar params_optimized.json
# IA_OPTUNA_PARAMS_PATH=       # ruta explícita a .json/.env (si no, usa params_optimized.json)
# IA_OPTUNA_EXCLUDE_KEYS=      # lista CSV de claves a NO sobrescribir (p.ej. IA_MIN_CONFIDENCE,RSI_FILTER)
# IA_OPTUNA_REPORT_OVERRIDES=1 # imprime una vez qué claves fueron sobrescritas al iniciar
# local_env.merge_optuna_into_config({}) — fusiona JSON Optuna en dict y os.environ tras load_env_file

# --- Sin órdenes tras abrir mercado (NY): relajar filtros (ia_auto_trade_loop) ---
