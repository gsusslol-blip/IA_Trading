# Copy this file to .env and fill the values you have.
# Local-first on Ryzen 5 1600 + GTX 1660 Ti 6GB:
#   Ollama on GPU (gemma2:2b ~2GB VRAM; llama3:8b ~4.5GB if it fits)
#   Faster-Whisper on CPU int8 so VRAM stays with the LLM.

GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# auto = Ollama if it's up, else Groq/OpenAI/Gemini
# ollama | groq | openai | gemini
LLM_PROVIDER=auto
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=gemma2:2b
# Keep model loaded in VRAM between turns (Ollama): 60m | 0 (unload) | -1 (forever)
OLLAMA_KEEP_ALIVE=60m
# Semantic search cache (web_search / wikipedia) — sandbox JSON, no vector DB.
# SEARCH_CACHE_ENABLED=1
# SEARCH_CACHE_THRESHOLD=0.85
# SEARCH_CACHE_TTL_SEC=86400
# SEARCH_CACHE_TTL_WIKI_SEC=604800
# Groq fallback only (if Ollama is down): openai/gpt-oss-20b
LLM_MODEL=

# STT: auto prefers faster-whisper if installed. Force CPU to protect 6GB VRAM.
STT_PROVIDER=auto
FASTER_WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# Telegram: talk to @BotFather, send /newbot, paste the token.
# Optional lock: your numeric user id so only you can talk to the bot.
# TELEGRAM_ALLOWED_CHAT_ID is an alias for TELEGRAM_USER_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=
TELEGRAM_ALLOWED_CHAT_ID=
# Sandbox user for street notes → data/users/<id>/workspace/diario_*.txt
TELEGRAM_REMOTE_USER=gsuss

# Optional WAN tunnel (ngrok) — phone off LAN via HTTPS.
# Free token: https://dashboard.ngrok.com/get-started/your-authtoken
# Without this, sync stays Wi‑Fi only (UDP 8788 LanFind).
# With token: HUD shows a QR (ilaria://sync) — scan with the phone camera (no Telegram).
NGROK_AUTHTOKEN=

# Health inbox: drop Garmin/Fitbit/Apple CSV|JSON|GPX into
#   data/users/<user>/workspace/inbox/
# Poll interval seconds (background thread in runtime).
# FIT binario: exportá a CSV/JSON primero.
# Watch history: workspace/smartwatch_history.sqlite3 (migrates legacy .json once).
HEALTH_INBOX_POLL_SEC=8

# HUD — Brave/local UI: http://localhost:8787 (NO https, NO 127.0.0.1 en Brave)
# 0.0.0.0 = tu celular en el mismo Wi-Fi puede hablarle a esta PC (LAN).
# 127.0.0.1 = solo esta máquina.
HUD_HOST=0.0.0.0
HUD_PORT=8787

# PC code updates via GitHub Releases (CDN).
# Ejemplo: ILARIA_UPDATE_URL=https://github.com/gsusslol-blip/Ilaria/releases/latest/download/version.json
ILARIA_UPDATE_URL=https://github.com/gsusslol-blip/Ilaria/releases/latest/download/version.json
ILARIA_GITHUB_REPO=gsusslol-blip/Ilaria
# 1/true = chequear al arrancar main.py (falla soft y sigue). 0/false = off
ILARIA_AUTO_UPDATE=1
# 1 = auto-heal Ollama ante timeout/5xx/connection en el chat
ILARIA_PASSIVE_HEAL=1

# 1 = aviso horario suave si Cursor/VS Code/Excel estan abiertos (0 = off)
# Con AUTONOMY=1 el dueño usa el loop de 30s en vez de este aviso horario.
PROACTIVE_HOURLY=1

# Loop autónomo (dueño): Python observa PC/HA y avisa. Gemma NO se llama cada 30s.
AUTONOMY=1
# Luces solas: 1 solo si hay occupancy/motion reales en Home Assistant.
AUTONOMY_HA=0

# 1 = si Ollama no responde, intentar ollama serve (no mata procesos).
SELF_HEAL=1

# Hands-free wake word (Picovoice Porcupine). Free personal key:
# https://console.picovoice.ai/
# WAKE_ENABLED=0 to disable. Custom "Ilaria" keyword: export .ppn and set WAKE_PPN_PATH
# or drop the file at data/wake/ilaria_windows.ppn or data/models/ilaria_windows.ppn.
# Without key/.ppn Ilaria still boots — use HUD Libre (client-side VAD).
PICOVOICE_ACCESS_KEY=
PICOVOICE_API_KEY=
WAKE_ENABLED=1
WAKE_KEYWORDS=computer,jarvis
WAKE_PPN_PATH=
WAKE_LISTEN_SECONDS=6

# Optional Spotify desktop Ctrl+L search (flaky). Default off. Needs pyautogui.
SPOTIFY_UI_CONTROL=0

# Optional vision / cameras. Default off. Do NOT put placeholder 192.168.x URLs.
# VISION_CAMERAS JSON list, e.g. [{"id":"patio","ha_entity":"light.patio"}]
VISION_ENABLED=0
VISION_CAMERAS=

# Quiet-Mode: silence beeps + proactive TTS when Steam/media/fullscreen owns focus.
# User chat / wake speech still works. 0 = always speak alerts.
QUIET_MODE_ENABLED=1
# QUIET_FORCE=1
# QUIET_EXTRA_EXES=mygame.exe,obs64.exe

ASSISTANT_NAME=Ilaria
USER_NAME=señor
# Piper on CPU (offline). es_MX-claude-medium does not exist in the catalog.
# Default: data/tts/es_MX-ald-medium.onnx (fast). Female AR: PIPER_MODEL=.../es_AR-daniela-high.onnx
# TTS_PROVIDER=edge keeps Microsoft Elena as a manual escape hatch.
TTS_PROVIDER=piper
TTS_VOICE=es-AR-ElenaNeural
# Optional override for short-phrase WAV cache (default: data/assets/tts_cache)
TTS_CACHE_DIR=data/assets/tts_cache
# Optional: PIPER_EXE= and PIPER_MODEL= absolute paths if not under data/tts/
PIPER_EXE=
PIPER_MODEL=
TIMEZONE=America/Argentina/Buenos_Aires

# Optional: first-run owner on THIS copy. Leave empty on public builds
# so the first person who registers becomes owner of their install.
OWNER_USERNAME=
OWNER_PASSWORD=

# Recovery codes live under data/recovery/<user>.txt (issue from /welcome).
# members_pc_hands is toggled by the owner in /admin (SQLite meta), default off.

# Optional: send real email (Gmail: app password, SMTP_HOST=smtp.gmail.com)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional: Home Assistant local (http://127.0.0.1:8123). Long-lived token in HA.
# Ilaria never talks to Tuya/Hue clouds directly. Lights on/off; climate 18–26 C; locks owner-only.
HA_URL=
HA_TOKEN=
# Watch fatigue → lights (needs HA_*). Off by default.
# HA_FATIGUE_ENABLED=1
# HA_FATIGUE_ON_ENTITIES=light.living,light.bedroom
# HA_FATIGUE_OFF_ENTITIES=light.living,light.bedroom
# HA_FATIGUE_POLL_SEC=45
